function download(t,n,type){let a=document.createElement('a'),u=URL.createObjectURL(new Blob([t],{type}));a.href=u;a.download=n;a.click();URL.revokeObjectURL(u)}function csv(a){if(!a.length)return alert('Nothing to export.');let k=['degreeType','country','city','university','programme','subject','language','duration','tuition','funding','deadline','sourceUrl','publicationStatus'];download([k.join(','),...a.map(p=>k.map(x=>'"'+String(p[x]??'').replace(/"/g,'""')+'"').join(','))].join('\n'),'studypath-export.csv','text/csv')}
document.addEventListener('click',e=>{let b=e.target.closest('[data-tool]');if(b)tool(b.dataset.tool);let s=e.target.closest('.save');if(s){let p=find(s.dataset.id);saved=saved.some(x=>String(x.id)===String(p.id))?saved.filter(x=>String(x.id)!==String(p.id)):[...saved,p];write('saved',saved);renderResults();$('savedCount').textContent=saved.length}let c=e.target.closest('.cmp');if(c){let id=c.dataset.id;compared=compared.includes(id)?compared.filter(x=>x!==id):compared.length<4?[...compared,id]:compared;if(compared.length>4)alert('Maximum four programmes.');write('compared',compared);renderResults()}let r=e.target.closest('.remove');if(r){saved=saved.filter(x=>String(x.id)!==r.dataset.id);write('saved',saved);tool('saved');renderResults()}if(e.target.id==='compareOpen')tool('compare');if(e.target.id==='clearCompare'){compared=[];write('compared',compared);tool('compare');renderResults()}if(e.target.id==='exportSaved')csv(saved);if(e.target.id==='exportResults')csv(filtered());if(e.target.id==='closeModal'||e.target.id==='modal')close();if(e.target.id==='resetChecks'){checks={};write('checks',checks);tool('documents')}if(e.target.id==='clearIelts'){write('ielts',{scores:{},minimum:{},selected:''});tool('ielts')}if(e.target.id==='resetAll'&&confirm('Clear all local StudyPath data?')){['saved','compared','apps','events','checks','ielts'].forEach(x=>localStorage.removeItem('studypath-'+x));saved=[];compared=[];apps=[];events=[];checks={};close();render()}if(e.target.id==='backupExport')download(JSON.stringify({saved,compared,apps,events,checks,ielts:read('ielts',{scores:{},minimum:{},selected:''})},null,2),'studypath-backup.json','application/json');let da=e.target.closest('.delApp');if(da){apps.splice(+da.dataset.i,1);write('apps',apps);tool('applications')}let de=e.target.closest('.delEvent');if(de){events.splice(+de.dataset.i,1);write('events',events);tool('deadlines')}});
document.addEventListener('submit',e=>{if(e.target.id==='ieltsForm'){e.preventDefault();let f=new FormData(e.target),scores={listening:Number(f.get('listening')),reading:Number(f.get('reading')),writing:Number(f.get('writing')),speaking:Number(f.get('speaking'))},valid=Object.values(scores).every(x=>Number.isFinite(x)&&x>=0&&x<=9&&Math.round(x*2)===x*2),selected=String(f.get('programme')||''),v=read('ielts',{scores:{},minimum:{},selected:''});if(!valid){$('ieltsResult').textContent='Enter all four valid scores from 0 to 9 in 0.5 steps.';return;}v.scores=scores;v.selected=selected;v.minimum=v.minimum||{};if(f.get('minimum')!=='')v.minimum[selected]=Number(f.get('minimum'));else delete v.minimum[selected];write('ielts',v);let overall=Math.round(Object.values(scores).reduce((a,b)=>a+b,0)/4*2)/2,minimum=v.minimum[selected],status=minimum===undefined?'Add an official programme minimum to compare.':overall>=minimum?'Your overall band meets or exceeds the entered overall minimum.':'Your overall band is below the entered overall minimum.';$('ieltsResult').innerHTML='<h3>Overall band: '+overall.toFixed(1)+'</h3><p>'+esc(status)+'</p><p class="muted">This checks the overall score only. Component minimums and accepted tests must be checked on the official course page.</p>';return;}if(e.target.id==='eligForm'){e.preventDefault();let f=new FormData(e.target),q=String(f.get('subject')).toLowerCase(),c=String(f.get('country')).toLowerCase(),d=String(f.get('degree')),a=P.filter(p=>(d==='Any'||deg(p)===d)&&(!q||get(p,['subject','field']).toLowerCase().includes(q)||get(p,['programme']).toLowerCase().includes(q))&&(!c||p.country.toLowerCase().includes(c))).slice(0,40);$('eligResults').innerHTML='<p class="muted">'+a.length+' potential matches. CGPA is not assessed where verified thresholds are unavailable.</p>'+a.map(p=>'<div class="saved-row"><div><b>'+esc(get(p,['programme']))+'</b><p>'+esc(get(p,['university']))+' · '+esc(p.country)+' · Verify requirements</p></div></div>').join('')}if(e.target.id==='appForm'){e.preventDefault();apps.push(Object.fromEntries(new FormData(e.target).entries()));write('apps',apps);tool('applications')}if(e.target.id==='eventForm'){e.preventDefault();events.push(Object.fromEntries(new FormData(e.target).entries()));write('events',events);tool('deadlines')}if(e.target.id==='costForm'){e.preventDefault();let f=new FormData(e.target),n=k=>Number(f.get(k)||0),y=n('years')||1,life=(n('accommodation')+n('food')+n('transport'))*12*y,total=Math.max(0,n('tuition')*y+life+n('insurance')*y+n('visa')+n('flight')+n('other')-n('scholarship'));$('costResult').innerHTML='<h3>Estimated total: '+esc(f.get('currency'))+' '+total.toLocaleString()+'</h3><p>First-year estimate: '+Math.max(0,n('tuition')+life/y+n('insurance')+n('visa')+n('flight')+n('other')/y-n('scholarship')/y).toLocaleString()+' · Total tuition: '+(n('tuition')*y).toLocaleString()+' · Living: '+life.toLocaleString()+' · Scholarship: −'+n('scholarship').toLocaleString()+'</p>'+(n('exchangeRate')>0?'<p>Converted estimate at your manual rate: '+(total*n('exchangeRate')).toLocaleString()+'</p>':'<p class="muted">Add a manual exchange rate to see a converted estimate.</p>')}if(e.target.id==='feedback'){e.preventDefault();let f=new FormData(e.target),sub=encodeURIComponent('StudyPath feedback: '+f.get('type')),body=encodeURIComponent(f.get('details'));window.location.href='mailto:'+"imdmominul196@gmail.com"+'?subject='+sub+'&body='+body;$('feedbackStatus').textContent='Your email app should open with a draft. StudyPath has not sent it.'}});
