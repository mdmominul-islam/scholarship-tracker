---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { readFile } from 'node:fs/promises';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const programmeData = JSON.parse(await readFile('public/data/programme-catalogue.json', 'utf8'));
const universityData = JSON.parse(await readFile('public/data/universities.json', 'utf8'));
const initialProgrammes = (programmeData.programmes || []).slice(0, 12);
const initialUniversities = (universityData.universities || []).slice(0, 8);
---
<BaseLayout title="StudyPath | Global Study Abroad Explorer" description={siteConfig.description}>
<header class="site-header"><div class="container header-row"><a href={base} class="brand"><span class="brand-mark">SP</span><span><b>StudyPath</b><small>Global education explorer</small></span></a><nav class="desktop-nav"><a href={`${base}countries/`}>Countries</a><a href={`${base}universities/`}>Universities</a><a href={`${base}courses/`}>Courses</a><a href={`${base}scholarships/`}>Scholarships</a><a href="#tools">Student tools</a><a href={`${base}resources/`}>Resources</a><a href={`${base}about/`}>About</a></nav><div class="header-actions"><a class="icon-link" href={`${base}search/`} aria-label="Global search">⌕</a><button id="languageToggle" class="mini-btn">বাংলা</button><button id="themeToggle" class="mini-btn" aria-label="Toggle theme">◐</button><button id="mobileMenu" class="mini-btn mobile-only">☰</button></div></div><nav id="mobileNav" class="mobile-nav" hidden><a href={`${base}countries/`}>Countries</a><a href={`${base}universities/`}>Universities</a><a href={`${base}courses/`}>Courses</a><a href={`${base}scholarships/`}>Scholarships</a><a href="#tools">Student tools</a><a href={`${base}resources/`}>Resources</a></nav></header>
<main>
<section class="hero"><div class="container hero-grid"><div><p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p><h1 data-i18n="hero">Your Global Education Journey Starts Here.</h1><p class="hero-text">Discover universities, degree programmes and scholarships around the world. Compare options and plan your next steps in one place.</p><div class="hero-points"><span>✓ Bachelor & Master</span><span>✓ Official-source links</span><span>✓ Free planning tools</span></div><div class="hero-buttons"><a class="btn primary" href="#search">Find a programme</a><a class="btn outline-light" href={`${base}countries/`}>Explore destinations</a></div></div>
<div class="search-panel" id="search"><h2>Find your study opportunity</h2><p class="muted">Choose degree level, then refine your search.</p><div class="degree-switch"><button class="degree-choice active" data-degree="All">All levels</button><button class="degree-choice" data-degree="Bachelor">Bachelor</button><button class="degree-choice" data-degree="Master">Master</button><button class="degree-choice" data-degree="PhD">PhD</button></div><input id="q" class="field" type="search" placeholder="University, course, subject or country…" aria-label="Search programmes"/><div class="filter-grid"><select id="country" class="field"><option value="">All countries</option></select><select id="subject" class="field"><option value="">All subjects</option></select><select id="sort" class="field"><option value="relevance">Sort: Relevance</option><option value="university">University A–Z</option><option value="country">Country A–Z</option></select></div><div class="search-bottom"><span id="status" aria-live="polite">Loading catalogues…</span><button id="clear" class="text-btn">Clear filters</button></div></div></div></section>
<section class="container stat-strip"><div class="stat-box"><b id="nPrograms">—</b><span>Programme records</span></div><div class="stat-box"><b id="nCountries">—</b><span>Destinations</span></div><div class="stat-box"><b id="nUniversities">—</b><span>Institutions</span></div><div class="stat-box"><b id="nFunding">—</b><span>Funding references</span></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow teal">EXPLORE OPPORTUNITIES</p><h2>Programme finder</h2><p class="muted">Missing information is marked for verification.</p></div><span id="resultCount" class="count-pill">0 programmes</span></div><div class="results-toolbar"><span id="activeFilter" class="muted"></span><div><button id="exportResults" class="btn soft small">Export CSV</button> <button id="compareOpen" class="btn soft small">Compare (<span id="compareCount">0</span>)</button></div></div><div id="results" class="results-grid">{initialProgrammes.map((p) => (<article class="programme-card"><div class="card-top"><span class="country-tag">{p.country}</span><span class="degree-tag">{p.degreeType}</span></div><h3>{p.programme}</h3><p class="muted">{p.university} · {p.city}</p><div class="facts"><span><small>Duration</small><b>{p.duration || 'Not confirmed'}</b></span><span><small>Tuition</small><b>{p.tuition || 'Not confirmed'}</b></span><span><small>Language</small><b>{p.language || 'Not confirmed'}</b></span></div><p class="card-note">{p.publicationStatus || 'Verify details with the institution.'}</p>{p.sourceUrl?.startsWith('http') ? <a class="btn link small" href={p.sourceUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a> : <span class="unverified">Official link not confirmed</span>}</article>))}</div><div class="center"><button id="more" class="btn soft" hidden>Load more</button></div></section>
<section class="section band"><div class="container"><div class="section-heading"><div><p class="eyebrow teal">EXPLORE THE WORLD</p><h2>Study destinations</h2><p class="muted">Counts refer to the available catalogue, not every programme offered nationally.</p></div><a class="arrow-link" href={`${base}countries/`}>All countries →</a></div><div id="countryCards" class="country-grid"></div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow teal">INSTITUTION DIRECTORY</p><h2>Universities to explore</h2></div><a class="arrow-link" href={`${base}universities/`}>All universities →</a></div><div id="universityCards" class="university-grid">{initialUniversities.map((u) => (<article class="directory-card"><b>{u.name}</b><p class="muted">{u.city} · {u.country}</p><small>{u.programmeCount} programme records</small></article>))}</div></section>
<section class="section band"><div class="container"><div class="section-heading"><div><p class="eyebrow teal">FUNDING YOUR STUDIES</p><h2>Scholarship & funding references</h2><p class="muted">Confirm availability, eligibility and coverage with each provider.</p></div><a class="arrow-link" href={`${base}scholarships/`}>Funding finder →</a></div><div id="fundingCards" class="scholarship-grid"></div></div></section>
<section class="section container" id="tools"><div class="section-heading"><div><p class="eyebrow teal">PLAN WITH CONFIDENCE</p><h2>Student planning workspace</h2><p class="muted">Non-sensitive planning details stay in this browser only.</p></div></div><div class="tool-grid">
<article class="tool-card"><div class="tool-icon">✓</div><h3>Eligibility checker</h3><p>Find potential matches using degree, subject and country.</p><button class="btn soft small" data-tool="eligibility">Check matches</button></article>
<article class="tool-card" id="saved"><div class="tool-icon">☆</div><h3>My shortlist</h3><p>Save and export favourite programmes.</p><button class="btn soft small" data-tool="saved">Open shortlist (<span id="savedCount">0</span>)</button></article>
<article class="tool-card"><div class="tool-icon">⇄</div><h3>Compare programmes</h3><p>Compare up to four options side by side.</p><button class="btn soft small" data-tool="compare">Compare</button></article>
<article class="tool-card"><div class="tool-icon">☷</div><h3>Document checklist</h3><p>Track preparation without uploading documents.</p><button class="btn soft small" data-tool="documents">Open checklist</button></article>
<article class="tool-card" id="applications"><div class="tool-icon">▣</div><h3>Application tracker</h3><p>Record applications and manually update progress.</p><button class="btn soft small" data-tool="applications">Track applications</button></article>
<article class="tool-card"><div class="tool-icon">৳</div><h3>Cost calculator</h3><p>Estimate tuition, living costs, travel and other expenses.</p><button class="btn soft small" data-tool="calculator">Estimate costs</button></article>
<article class="tool-card"><div class="tool-icon">◷</div><h3>Deadline planner</h3><p>Record application, scholarship and test dates.</p><button class="btn soft small" data-tool="deadlines">Plan deadlines</button></article>
<article class="tool-card"><div class="tool-icon">⇧</div><h3>Backup & restore</h3><p>Export or restore local planning data.</p><button class="btn soft small" data-tool="backup">Manage backup</button></article><article class="tool-card"><div class="tool-icon">◉</div><h3>IELTS scoreboard</h3><p>Calculate your overall band and compare it with a programme minimum you enter.</p><button class="btn soft small" data-tool="ielts">Open IELTS tool</button></article></div></section>
<section class="section band"><div class="container"><div class="section-heading"><div><p class="eyebrow teal">HOW IT WORKS</p><h2>Explore. Compare. Prepare. Apply.</h2></div></div><div class="steps-grid"><div><b>01</b><h3>Explore</h3><p>Search countries, universities and programmes.</p></div><div><b>02</b><h3>Compare</h3><p>Review available information and shortlist options.</p></div><div><b>03</b><h3>Check</h3><p>Use preliminary matching and verify requirements.</p></div><div><b>04</b><h3>Prepare</h3><p>Organise documents and estimate your budget.</p></div><div><b>05</b><h3>Plan</h3><p>Record deadlines and application progress.</p></div><div><b>06</b><h3>Apply officially</h3><p>Use official university or scholarship portals.</p></div></div></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow teal">LEARN & PREPARE</p><h2>Study abroad resource centre</h2></div><a class="arrow-link" href={`${base}resources/`}>All guides →</a></div><div class="guide-grid"><a class="guide-card" href={`${base}resources/#applications`}><span>01 / APPLICATIONS</span><h3>University application basics</h3><p>Build a timeline and check programme requirements.</p></a><a class="guide-card" href={`${base}resources/#scholarships`}><span>02 / FUNDING</span><h3>Scholarship preparation</h3><p>Understand coverage, eligibility and deadlines.</p></a><a class="guide-card" href={`${base}resources/#english-tests`}><span>03 / ENGLISH TESTS</span><h3>IELTS, TOEFL & PTE</h3><p>Check accepted tests and component scores.</p></a><a class="guide-card" href={`${base}resources/#sop-cv`}><span>04 / DOCUMENTS</span><h3>SOP & academic CV</h3><p>Present academic motivation and experience clearly.</p></a></div></section>
<section class="section band"><div class="container faq-layout"><div><p class="eyebrow teal">COMMON QUESTIONS</p><h2>Frequently asked questions</h2></div><div class="faq-list"><details><summary>Are all programme details verified?</summary><p>No. Verify every fee, deadline and requirement on the official institution page. Some records need verification.</p></details><details><summary>Does StudyPath guarantee admission or scholarships?</summary><p>No. Admission and scholarship decisions are made only by the relevant providers.</p></details><details><summary>Does StudyPath store personal documents?</summary><p>No. There is no document upload. Tools store only non-sensitive planning details in your browser.</p></details><details><summary>Will my shortlist sync across devices?</summary><p>No. This static website does not provide accounts or cloud synchronisation.</p></details><details><summary>Can I apply through StudyPath?</summary><p>No. Apply only through official university or scholarship portals.</p></details></div></div></section>
<section class="section container" id="writing-support"><div class="feedback-panel"><div><p class="eyebrow teal">APPLICATION WRITING SUPPORT</p><h2>Need help preparing your application documents?</h2><p class="muted">I offer personalised writing and editing support for students applying to international universities.</p><ul class="service-list"><li>SOP (Statement of Purpose)</li><li>CV / Academic Resume</li><li>Recommendation Letter drafting support</li><li>Motivation Letter</li></ul><p class="muted">Send an email with the document you need, your target programme and university, and your background. All documents are prepared using your genuine academic and personal information.</p><a class="btn primary" href="mailto:imdmominul196@gmail.com?subject=StudyPath%20-%20Application%20Writing%20Support&body=Hello%2C%0A%0AI%20need%20help%20with%3A%20SOP%20%2F%20CV%20%2F%20Recommendation%20Letter%20%2F%20Motivation%20Letter.%0A%0ATarget%20university%20and%20programme%3A%0A%0ADegree%20and%20intake%3A%0A%0AMy%20academic%20background%3A%0A%0AThank%20you.">Email for writing support</a></div><div><p class="eyebrow teal">DIRECT CONTACT</p><h2>Contact by email</h2><p class="muted">For service enquiries, corrections, programme suggestions or general questions:</p><p><a class="service-email" href="mailto:imdmominul196@gmail.com">imdmominul196@gmail.com</a></p><p class="muted">Please include your name, target university and programme so I can understand your request.</p><a class="btn soft" href={`${base}contact/`}>Contact & feedback page</a></div></div></section>
<section class="section container"><div class="feedback-panel"><div><p class="eyebrow teal">REPORT AN ISSUE</p><h2>Help improve the directory</h2><p class="muted">Prepare a feedback email in your own email application. StudyPath does not silently send reports.</p></div><form id="feedback" class="feedback-form"><label>Report type<select name="type" class="field"><option>Incorrect information</option><option>Broken official link</option><option>Outdated scholarship</option><option>Website problem</option><option>Content suggestion</option><option>General feedback</option></select></label><label>Details<textarea name="details" class="field" rows="3" required maxlength="1500"></textarea></label><button class="btn primary">Prepare email</button><p id="feedbackStatus" class="muted" aria-live="polite"></p></form></div></section>
</main>
<footer class="site-footer"><div class="container footer-grid"><div><a class="brand footer-brand" href={base}><span class="brand-mark">SP</span><span><b>StudyPath</b><small>Global education explorer</small></span></a><p class="muted footer-desc">Independent educational information and planning. Not affiliated with universities, governments or scholarship providers.</p></div><div><h3>Explore</h3><a href={`${base}countries/`}>Countries</a><a href={`${base}universities/`}>Universities</a><a href={`${base}courses/`}>Courses</a><a href={`${base}scholarships/`}>Scholarships</a></div><div><h3>Student tools</h3><a href="#tools">Planning workspace</a><a href="#saved">My shortlist</a><a href="#applications">Application tracker</a><a href={`${base}resources/`}>Resources</a></div><div><h3>Information</h3><a href={`${base}about/`}>About</a><a href={`${base}contact/`}>Contact</a><a href={`${base}privacy-policy/`}>Privacy</a><a href={`${base}terms/`}>Terms</a><a href={`${base}disclaimer/`}>Disclaimer</a><a href={`${base}copyright/`}>Copyright</a></div></div><div class="container footer-bottom">© <span id="year"></span> StudyPath · Created & maintained by <a class="footer-author" href="https://github.com/mdmominul-islam" target="_blank" rel="noopener noreferrer">Mominul Islam</a> · Public Health Researcher · <a class="footer-author" href="https://github.com/mdmominul-islam/scholarship-tracker" target="_blank" rel="noopener noreferrer">Project on GitHub</a></div>
<div class="container footer-disclaimer">Disclaimer: StudyPath provides independent educational information and planning tools. It is not affiliated with universities or scholarship providers. Always verify programme details, fees, eligibility and deadlines with official sources. No admission, scholarship or visa outcome is guaranteed. <a href={`${base}disclaimer/`}>Read full disclaimer</a>.</div></footer>
<div id="modal" class="modal" hidden role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal-box"><div class="modal-head"><h2 id="modalTitle">Student tool</h2><button id="closeModal" class="mini-btn">×</button></div><div id="modalContent"></div></div></div><nav class="bottom-nav"><a href={base}>⌂<span>Home</span></a><a href="#search">⌕<span>Explore</span></a><a href="#saved">☆<span>Saved</span></a><a href="#applications">▣<span>Plan</span></a><a href="#tools">☷<span>Tools</span></a></nav>
<script>
const BASE=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL+'/',$=id=>document.getElementById(id),read=(k,d)=>{try{return JSON.parse(localStorage.getItem('studypath-'+k)||'null')??d}catch{return d}},write=(k,v)=>{try{localStorage.setItem('studypath-'+k,JSON.stringify(v));return true}catch{return false}},esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),get=(p,ks,d='Not confirmed')=>{for(const k of ks)if(p?.[k]!=null&&String(p[k]).trim())return String(p[k]);return d};
let P=[],C=[],U=[],S=[],degree='All',limit=12,saved=read('saved',[]),compared=read('compared',[]),apps=read('apps',[]),events=read('events',[]),checks=read('checks',{});
const deg=p=>{let d=get(p,['degreeType','degree'],'Other').toLowerCase();return d.includes('bachelor')?'Bachelor':d.includes('master')?'Master':d.includes('phd')?'PhD':'Other'};
async function migrateLegacy(){if(read('legacyMigrated',false))return;const oldJson=k=>{try{return JSON.parse(localStorage.getItem(k)||'null')}catch{return null}};const fav=oldJson('trk_fav')||[],status=oldJson('trk_status')||{},global=oldJson('trk_global_shortlist')||{},planner=oldJson('trk_planner_v1')||{};const addSaved=id=>{let p=P.find(x=>String(x.id)===String(id));if(p&&!saved.some(x=>String(x.id)===String(p.id)))saved.push(p)};fav.forEach(n=>addSaved('legacy-master-'+n));Object.keys(global).forEach(k=>{if(global[k])addSaved(k.startsWith('local-')?'legacy-master-'+k.slice(6):k)});for(const [n,st] of Object.entries(status)){let p=P.find(x=>x.id==='legacy-master-'+n);if(p&&!apps.some(a=>a.university===p.university&&a.programme===p.programme)){const map={Preparing:'Preparing Documents',Applied:'Application Submitted',Offer:'Unconditional Offer'};apps.push({university:p.university,country:p.country,programme:p.programme,degree:'Master',status:map[st]||st,deadline:'',notes:'Migrated from the previous StudyPath application status.'})}}for(const [n,a] of Object.entries(planner.apps||{})){let p=P.find(x=>x.id==='legacy-master-'+n);if(p&&!apps.some(x=>x.university===p.university&&x.programme===p.programme))apps.push({university:p.university,country:p.country,programme:p.programme,degree:'Master',status:status[n]||'Researching',deadline:a.date||'',notes:a.notes||'Migrated from the previous StudyPath planner.'})}const oldIelts=oldJson('trk_ielts_scores'),oldReq=oldJson('trk_ielts_requirements')||{},selected=localStorage.getItem('trk_ielts_selected')||'';if(oldIelts){let scores={listening:oldIelts.listening??oldIelts.Listening??'',reading:oldIelts.reading??oldIelts.Reading??'',writing:oldIelts.writing??oldIelts.Writing??'',speaking:oldIelts.speaking??oldIelts.Speaking??''};const migratedMinimum={};for(const [n,v] of Object.entries(oldReq))migratedMinimum['legacy-master-'+n]=v;write('ielts',{scores,minimum:migratedMinimum,selected:selected?'legacy-master-'+selected:''})}if(localStorage.getItem('trk_theme'))write('theme',localStorage.getItem('trk_theme'));if(localStorage.getItem('trk_lang'))write('language',localStorage.getItem('trk_lang'));write('saved',saved);write('apps',apps);write('legacyMigrated',true)}
async function load(){try{let a=await Promise.all(['programme-catalogue.json','countries.json','universities.json','scholarships.json'].map(async f=>{let r=await fetch(BASE+'data/'+f);if(!r.ok)throw Error(f+' missing');return r.json()}));P=a[0].programmes||[];C=a[1].countries||[];U=a[2].universities||[];S=a[3].scholarships||[];migrateLegacy();$('status').textContent=P.length.toLocaleString()+' records loaded';[['nPrograms',P.length],['nCountries',C.length],['nUniversities',U.length],['nFunding',S.length]].forEach(([id,n])=>$(id).textContent=Number(n).toLocaleString());render()}catch(e){$('status').textContent='Catalogue error: '+e.message;$('results').innerHTML='<div class="empty-state">Catalogue could not load. Refresh or report the issue.</div>'}}
function fill(id,vals,label){let e=$(id),v=e.value;e.innerHTML='<option value="">'+label+'</option>'+[...new Set(vals.filter(x=>x&&x!=='Not confirmed'))].sort().map(x=>'<option>'+esc(x)+'</option>').join('');e.value=v}
function filtered(){let q=$('q').value.toLowerCase().trim(),c=$('country').value,s=$('subject').value,a=P.filter(p=>(degree==='All'||deg(p)===degree)&&(!q||[get(p,['programme','courseName']),get(p,['university','institution']),p.country,get(p,['subject','field']),get(p,['funding'])].join(' ').toLowerCase().includes(q))&&(!c||p.country===c)&&(!s||get(p,['subject','field'])===s));if($('sort').value==='university')a.sort((x,y)=>get(x,['university']).localeCompare(get(y,['university'])));if($('sort').value==='country')a.sort((x,y)=>get(x,['country']).localeCompare(get(y,['country'])));return a}
function card(p){let id=String(p.id),s=saved.some(x=>String(x.id)===id),c=compared.includes(id),url=get(p,['sourceUrl','officialUniversityUrl','detailUrl'],'');return '<article class="programme-card"><div class="card-top"><span class="country-tag">'+esc(p.country)+'</span><span class="degree-tag">'+esc(deg(p))+'</span></div><h3>'+esc(get(p,['programme','courseName']))+'</h3><p class="muted">'+esc(get(p,['university','institution']))+' · '+esc(get(p,['city']))+'</p><div class="facts"><span><small>Duration</small><b>'+esc(get(p,['duration']))+'</b></span><span><small>Tuition</small><b>'+esc(get(p,['tuition']))+'</b></span><span><small>Language</small><b>'+esc(get(p,['language','teachingLanguage']))+'</b></span></div><p class="card-note">'+esc(get(p,['note','publicationStatus'],'Verify with institution.'))+'</p><div class="card-actions"><button class="btn soft small save" data-id="'+esc(id)+'">'+(s?'✓ Saved':'☆ Save')+'</button><button class="btn soft small cmp" data-id="'+esc(id)+'">'+(c?'✓ Selected':'⇄ Compare')+'</button>'+(url.startsWith('http')?'<a class="btn link small" href="'+esc(url)+'" target="_blank" rel="noopener noreferrer">Source ↗</a>':'<span class="unverified">Official link not confirmed</span>')+'</div></article>'}
function renderResults(){let a=filtered();$('resultCount').textContent=a.length.toLocaleString()+' programmes';$('results').innerHTML=a.slice(0,limit).map(card).join('')||'<div class="empty-state">No matching programmes. Change your filters.</div>';$('more').hidden=a.length<=limit;$('more').textContent='Load more ('+(a.length-limit)+')';$('activeFilter').textContent=(degree==='All'?'All degree levels':degree)+' · '+($('country').value||'All countries')+' · '+($('subject').value||'All subjects');$('compareCount').textContent=compared.length;$('savedCount').textContent=saved.length}
function render(){fill('country',P.filter(p=>degree==='All'||deg(p)===degree).map(p=>p.country),'All countries');fill('subject',P.filter(p=>degree==='All'||deg(p)===degree).map(p=>get(p,['subject','field'],'')),'All subjects');renderResults();$('countryCards').innerHTML=C.slice(0,12).map(c=>'<a class="country-card" href="'+BASE+'countries/#'+encodeURIComponent(c.name)+'"><span class="country-symbol">'+esc(c.name.slice(0,2).toUpperCase())+'</span><b>'+esc(c.name)+'</b><small>'+c.programmeCount+' programme records</small></a>').join('');$('universityCards').innerHTML=U.slice(0,8).map(u=>'<article class="directory-card"><b>'+esc(u.name)+'</b><p class="muted">'+esc(u.city)+' · '+esc(u.country)+'</p><small>'+u.programmeCount+' programme records</small></article>').join('');$('fundingCards').innerHTML=S.slice(0,8).map(s=>'<article class="directory-card"><span class="funding-tag">'+esc(s.coverage)+'</span><b>'+esc(s.name)+'</b><p class="muted">'+esc(s.provider)+' · '+esc(s.country)+'</p><small>Needs provider verification</small></article>').join('')}
function modal(title,html){$('modalTitle').textContent=title;$('modalContent').innerHTML=html;$('modal').hidden=false;document.body.classList.add('modal-open')}function close(){ $('modal').hidden=true;document.body.classList.remove('modal-open')}
const find=id=>P.find(p=>String(p.id)===String(id));
function tool(k){if(k==='saved')return modal('My shortlist',saved.length?saved.map(p=>'<div class="saved-row"><div><b>'+esc(get(p,['programme']))+'</b><p>'+esc(get(p,['university']))+' · '+esc(p.country)+'</p></div><button class="btn soft small remove" data-id="'+esc(p.id)+'">Remove</button></div>').join('')+'<button id="exportSaved" class="btn primary">Export CSV</button>':'<p class="muted">No saved programmes yet.</p>');
