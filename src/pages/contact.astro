---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Contact & Feedback | StudyPath"><main class="container py-14"><a class="text-sm font-bold text-teal-700" href={base}>← Back to StudyPath</a><article class="surface mt-6 p-7 md:p-10"><h1 class="text-3xl font-extrabold">Contact & Feedback</h1><p class="muted mt-5 max-w-4xl leading-8">For corrections, broken official links, outdated scholarship information or suggestions, use your email application to contact the site maintainer. Configure the public contact email in the site configuration before publishing a mail link. The static website does not claim to deliver form submissions to an administrator.</p></article></main></BaseLayout>