---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Contact | StudyPath"><main class="container py-14"><a class="text-sm font-bold text-teal-700" href={base}>← StudyPath home</a><article class="surface mt-6 max-w-3xl p-7"><p class="eyebrow teal">CONTACT & REPORTS</p><h1 class="mt-2 text-3xl font-extrabold">Contact StudyPath</h1><p class="muted mt-4">Report incorrect programme information, broken official links, outdated funding references or website issues. This static website prepares an email in your own email application; it does not collect or send form submissions to a server.</p><form id="contactForm" class="mt-6 grid gap-4"><label class="grid gap-2 text-sm font-bold">Report type<select name="type" class="field"><option>Incorrect information</option><option>Broken official link</option><option>Outdated scholarship</option><option>Incorrect admission requirements</option><option>Website problem</option><option>Content suggestion</option><option>General feedback</option></select></label><label class="grid gap-2 text-sm font-bold">Details<textarea name="details" class="field" rows="5" maxlength="2000" required placeholder="Include the programme name and official source if possible."></textarea></label><button class="btn primary" type="submit">Prepare email</button><p id="contactStatus" class="muted text-xs" aria-live="polite"></p></form><p class="muted mt-6 text-sm">Contact email: <a class="font-bold text-teal-700" href="mailto:imdmominul196@gmail.com">imdmominul196@gmail.com</a></p></article></main><script>document.getElementById('contactForm').addEventListener('submit',e=>{e.preventDefault();const f=new FormData(e.currentTarget),subject=encodeURIComponent('StudyPath: '+f.get('type')),body=encodeURIComponent(f.get('details'));location.href='mailto:imdmominul196@gmail.com?subject='+subject+'&body='+body;document.getElementById('contactStatus').textContent='Your email application should open with a draft. It has not been sent by this website.';});</script></BaseLayout>