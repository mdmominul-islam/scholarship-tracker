---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<BaseLayout title="Global Search | StudyPath"><main class="container py-12"><a class="text-sm font-bold text-teal-700" href={base}>← StudyPath home</a><div class="mt-7"><p class="eyebrow teal">SEARCH STUDYPATH</p><h1 class="text-3xl font-extrabold">Global study-abroad search</h1><p class="muted mt-2 max-w-3xl">Search programme, country, university and funding records from the local catalogues. Resource guides are available in the Resource Centre.</p></div><div class="surface mt-6 grid gap-3 p-4 md:grid-cols-[1fr_190px]"><input id="globalQ" class="field" type="search" placeholder="Search university, course, country, subject or funding…"/><select id="globalCategory" class="field"><option value="all">All categories</option><option value="programmes">Programmes</option><option value="countries">Countries</option><option value="universities">Universities</option><option value="scholarships">Funding references</option></select></div><p id="globalStatus" class="muted my-4 text-sm" aria-live="polite">Loading local catalogues…</p><div id="globalResults" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div></main>
<script>
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL+'/',$=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let data={};async function load(){try{const files=['programme-catalogue.json','countries.json','universities.json','scholarships.json'];const all=await Promise.all(files.map(async f=>{const r=await fetch(base+'data/'+f);if(!r.ok)throw Error(f);return r.json()}));data={programmes:all[0].programmes||[],countries:all[1].countries||[],universities:all[2].universities||[],scholarships:all[3].scholarships||[]};$('globalStatus').textContent='Loaded '+Object.values(data).reduce((n,a)=>n+a.length,0).toLocaleString()+' local records. Search to begin.';render()}catch(e){$('globalStatus').textContent='Search catalogue unavailable: '+e.message}}
function render(){const q=$('globalQ').value.trim().toLowerCase(),cat=$('globalCategory').value,groups=[['programmes',data.programmes||[],'programme','university','/courses/'],['countries',data.countries||[],'name','name','/countries/'],['universities',data.universities||[],'name','country','/universities/'],['scholarships',data.scholarships||[],'name','provider','/scholarships/']];let hits=[];for(const [type,rows,title,sub,path] of groups){if(cat!=='all'&&cat!==type)continue;for(const r of rows){const blob=JSON.stringify(r).toLowerCase();if(q&&blob.includes(q))hits.push({type,title:r[title]||r.programme||r.university,sub:r[sub]||r.country||'',path:path+(type==='countries'?'#'+encodeURIComponent(r.name):''),url:r.sourceUrl||r.officialUrl||r.officialLinks?.[0]||''})}}$('globalStatus').textContent=q?hits.length.toLocaleString()+' matching records':'Enter a search term to search across the catalogues.';$('globalResults').innerHTML=q?hits.slice(0,100).map(x=>'<article class="surface p-4"><span class="pill">'+esc(x.type)+'</span><h2 class="mt-3 font-bold">'+esc(x.title)+'</h2><p class="muted mt-1 text-xs">'+esc(x.sub)+'</p><a class="mt-3 inline-block text-sm font-bold text-teal-700" href="'+base+x.path.replace(/^\//,'')+'">Open directory →</a>'+(x.url&&/^https?:\/\//.test(x.url)?'<a class="ml-3 text-sm text-teal-700" href="'+esc(x.url)+'" target="_blank" rel="noopener noreferrer">Official source ↗</a>':'')+'</article>').join('')||'<div class="surface p-8 text-center muted">No results found. Try a broader search.</div>':''}
$('globalQ').addEventListener('input',render);$('globalCategory').addEventListener('change',render);load();
</script></BaseLayout>