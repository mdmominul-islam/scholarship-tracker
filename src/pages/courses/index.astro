---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const catalogue = JSON.parse(await readFile('public/data/programme-catalogue.json', 'utf8'));
const records = catalogue.programmes || [];
const initialRecords = records.slice(0, 30);
---
<BaseLayout title="Course Finder | StudyPath" description="Search academic programmes across degree levels, countries, institutions and subjects.">
<main class="container py-12">
<a class="text-sm font-bold text-teal-700" href={base}>← StudyPath home</a>
<div class="section-heading mt-7"><div><p class="eyebrow teal">STUDYPATH DIRECTORY</p><h1 class="text-3xl font-extrabold">Course Finder</h1><p class="muted mt-2 max-w-3xl">Search academic programmes across degree levels, countries, institutions and subjects.</p></div></div>
<div class="surface grid gap-3 p-4 md:grid-cols-2 lg:grid-cols-4">
<input id="directorySearch" class="field" type="search" placeholder="Search programme, course, university or keyword…" aria-label="Search programmes"/>
<select id="degreeFilter" class="field"><option value="">All degree levels</option><option value="Bachelor">Bachelor</option><option value="Master">Master</option><option value="PhD">PhD</option></select>
<select id="countryFilter" class="field"><option value="">All countries</option></select>
<select id="subjectFilter" class="field"><option value="">All subjects</option></select>
<select id="directorySort" class="field"><option value="name">Programme A–Z</option><option value="university">University A–Z</option><option value="country">Country A–Z</option></select>
</div>
<p id="directoryStatus" class="muted my-4 text-sm" aria-live="polite">Loading local catalogue…</p>
<div id="directoryResults" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{initialRecords.map((r) => (<article class="surface p-4"><span class="pill">{r.degreeType || 'Programme'}</span><h2 class="mt-3 font-bold">{r.programme || 'Untitled programme'}</h2><p class="muted mt-1 text-xs">{r.university || 'Institution not confirmed'} · {r.country || 'Country not confirmed'}</p><dl class="mt-3 grid grid-cols-2 gap-2 text-xs"><div><dt class="muted">Subject</dt><dd class="font-semibold">{r.subject || 'Not confirmed'}</dd></div><div><dt class="muted">Duration</dt><dd class="font-semibold">{r.duration || 'Not confirmed'}</dd></div><div><dt class="muted">Tuition</dt><dd class="font-semibold">{r.tuition || 'Not confirmed'}</dd></div><div><dt class="muted">Language</dt><dd class="font-semibold">{r.language || 'Not confirmed'}</dd></div></dl><p class="muted mt-3 text-xs">{r.publicationStatus || r.note || 'Verify current details with the official provider.'}</p>{r.sourceUrl?.startsWith('http') ? <a class="mt-3 inline-block text-sm font-bold text-teal-700" href={r.sourceUrl} target="_blank" rel="noopener noreferrer">Official source ↗</a> : <span class="mt-3 inline-block text-xs text-amber-700">Official link not confirmed</span>}</article>))}</div>
<div class="mt-6 flex justify-center"><button id="directoryMore" class="btn secondary" hidden>Load more</button></div>
<div class="surface mt-10 p-5"><h2 class="font-bold">Information and verification</h2><p class="muted mt-2 text-sm">StudyPath is an independent information resource. Catalogue records may be incomplete or require verification. Always use official institution and scholarship-provider websites for current tuition, admission criteria, eligibility and deadlines.</p></div>
</main>
<script>
const base=import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL+'/', file="programme-catalogue.json";
const $=id=>document.getElementById(id), esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let records=[],limit=30;
function fillFilter(id,values,label){const el=$(id),previous=el.value,valuesSorted=[...new Set(values.filter(v=>v&&v!=="Not confirmed"))].sort((a,b)=>a.localeCompare(b));el.innerHTML='<option value="">'+label+'</option>'+valuesSorted.map(v=>'<option value="'+esc(v)+'">'+esc(v)+'</option>').join('');el.value=previous;}
async function load(){try{const response=await fetch(base+'data/'+file);if(!response.ok)throw Error('Programme catalogue unavailable');const data=await response.json();records=data.programmes||[];fillFilter('countryFilter',records.map(x=>x.country),'All countries');fillFilter('subjectFilter',records.map(x=>x.subject),'All subjects');$('directoryStatus').textContent=records.length.toLocaleString()+' programmes loaded · Search by programme name, university, country or subject.';render()}catch(e){$('directoryStatus').textContent='Could not load catalogue: '+e.message+' · Showing the preloaded records below.';}}
function render(){const q=$('directorySearch').value.trim().toLowerCase(),degree=$('degreeFilter').value,country=$('countryFilter').value,subject=$('subjectFilter').value,sort=$('directorySort').value;
let rows=records.filter(x=>(!degree||x.degreeType===degree)&&(!country||x.country===country)&&(!subject||x.subject===subject)&&(!q||[x.programme,x.university,x.country,x.subject,x.degreeType,x.city,x.language].join(' ').toLowerCase().includes(q)));
rows.sort((a,b)=>String(a[sort==='university'?'university':sort==='country'?'country':'programme']||'').localeCompare(String(b[sort==='university'?'university':sort==='country'?'country':'programme']||'')));
$('directoryStatus').textContent=rows.length.toLocaleString()+' matching programmes · '+records.length.toLocaleString()+' total records. Details must be verified with each institution.';
$('directoryResults').innerHTML=rows.slice(0,limit).map(x=>{const url=x.sourceUrl||x.officialUniversityUrl||x.detailUrl||'';return '<article class="surface p-4"><div class="flex flex-wrap gap-2"><span class="pill">'+esc(x.degreeType||'Programme')+'</span><span class="pill">'+esc(x.country)+'</span></div><h2 class="mt-3 font-bold">'+esc(x.programme)+'</h2><p class="muted mt-1 text-xs">'+esc(x.university)+' · '+esc(x.city)+'</p><dl class="mt-3 grid grid-cols-2 gap-2 text-xs"><div><dt class="muted">Subject</dt><dd class="font-semibold">'+esc(x.subject||'Not confirmed')+'</dd></div><div><dt class="muted">Duration</dt><dd class="font-semibold">'+esc(x.duration||'Not confirmed')+'</dd></div><div><dt class="muted">Tuition</dt><dd class="font-semibold">'+esc(x.tuition||'Not confirmed')+'</dd></div><div><dt class="muted">Language</dt><dd class="font-semibold">'+esc(x.language||'Not confirmed')+'</dd></div><div><dt class="muted">Deadline</dt><dd class="font-semibold">'+esc(x.deadline||'Not confirmed')+'</dd></div><div><dt class="muted">Status</dt><dd class="font-semibold">'+esc(x.publicationStatus||'Needs verification')+'</dd></div></dl><p class="muted mt-3 text-xs">'+esc(x.note||'Verify current details with the official provider.')+'</p>'+(url&&url.startsWith('http')?'<a class="mt-3 inline-block text-sm font-bold text-teal-700" href="'+esc(url)+'" target="_blank" rel="noopener noreferrer">Official source ↗</a>':'<span class="mt-3 inline-block text-xs text-amber-700">Official link not confirmed</span>')+'</article>'}).join('')||'<div class="surface p-8 text-center muted">No matching programmes found. Try another keyword or remove a filter.</div>';
$('directoryMore').hidden=rows.length<=limit;$('directoryMore').textContent='Load more ('+(rows.length-limit)+')';}
$('directorySearch').addEventListener('input',()=>{limit=30;render()});['degreeFilter','countryFilter','subjectFilter','directorySort'].forEach(id=>$(id).addEventListener('change',()=>{limit=30;render()}));$('directoryMore').addEventListener('click',()=>{limit+=30;render()});load();
</script>
</BaseLayout>